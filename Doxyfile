# ---- Project ----
PROJECT_NAME           = "ZenitUI"
PROJECT_BRIEF          = "Retained-mode C++20 UI framework"
OUTPUT_DIRECTORY       = build/docs

# ---- Input ----
INPUT                  = docs/Guides.dox build/docs/generated_examples.dox include backends/raylib
FILE_PATTERNS          = *.hpp *.h *.dox
RECURSIVE              = YES
EXAMPLE_PATH           = examples
EXAMPLE_PATTERNS       = *.cpp *.hpp *.h *.zm *.zstyle *.fs *.vs *.glsl
EXAMPLE_RECURSIVE      = NO
EXCLUDE_SYMBOLS        = detail *::detail

# ---- Extraction ----
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
BUILTIN_STL_SUPPORT    = YES
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES

# ---- Warnings ----
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES

# ---- HTML Output ----
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_COLORSTYLE        = LIGHT
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
SEARCHENGINE           = YES
HTML_EXTRA_STYLESHEET  = docs/theme/doxygen-awesome.css \
                         docs/theme/doxygen-awesome-sidebar-only.css \
                         docs/theme/custom.css

# ---- Unused formats ----
GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO

# ---- Diagrams (Graphviz) ----
HAVE_DOT               = YES
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = NO
INCLUDE_GRAPH          = NO
INCLUDED_BY_GRAPH      = NO
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES