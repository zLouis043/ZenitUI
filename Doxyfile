# ---- Project ----
PROJECT_NAME           = "ZenitUI"
PROJECT_BRIEF          = "Retained-mode C++20 UI framework"
OUTPUT_DIRECTORY       = build/docs

# ---- Input ----
INPUT                  = README.md include backends/raylib
FILE_PATTERNS          = *.hpp *.h *.md
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = README.md
EXCLUDE_SYMBOLS        = detail *::detail

# ---- Extraction ----
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
BUILTIN_STL_SUPPORT    = YES
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES

# ---- Warnings ----
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES

# ---- HTML Output ----
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_COLORSTYLE        = DARK
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
SEARCHENGINE           = YES

# ---- Unused formats ----
GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO

# ---- Diagrams (Graphviz) ----
HAVE_DOT               = YES
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = NO
INCLUDE_GRAPH          = NO
INCLUDED_BY_GRAPH      = NO
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES