/* =========================================================================
   ZenitUI — Example 06: ZMarkup
   Styling for the ZMarkup tree. Kept in a separate file, as a real
   project would do.
   ========================================================================= */

:root {
    --bg:         #141418;
    --surface:    #1e1e24;
    --surface-hi: #26262e;
    --primary:    #4a9eff;
    --primary-hi: #7bc0ff;
    --text:       #e8e8ee;
    --text-dim:   #9090a0;
}

Stack#page {
    background: var(--bg);
    color: var(--text);
    font-size: 15px;
    padding: 3vh 3vw;
    gap: 12px;
    width: 100%;
    height: 100%;
}

.card {
    background: var(--surface);
    radius: 8px;
    padding: 16px;
    gap: 12px;
    width: 100%;
}

.card-title {
    color: var(--primary);
    font-size: 17px;
    letter-spacing: 1px;
}

.card-desc {
    color: var(--text-dim);
    font-size: 13px;
}

.row {
    background: var(--surface-hi);
    radius: 6px;
    padding: 10px 14px;
    gap: 16px;
    items-v: center;
    width: 100%;
}

.row-label {
    color: var(--text-dim);
    font-size: 13px;
    min-width: 160px;
}

.btn-primary {
    background: var(--primary);
    color: #ffffff;
    radius: 6px;
    padding: 8px 16px;
    transition: background 0.15s ease-out-quad;
}
.btn-primary:hover   { background: var(--primary-hi); }

TextInput {
    background: #14141a;
    color: var(--text);
    radius: 4px;
    padding: 8px 12px;
    border-width: 1px;
    border-color: #3a3a44;
    min-width: 200px;
    transition: border-color 0.18s ease-out-quad;
}
TextInput:focus { border-color: var(--primary); }

Slider {
    width: 200px;
    height: 24px;
}
Slider::track { background: #3a3a44; radius: 4px; }
Slider::fill  { color: var(--primary); }
Slider::knob  { color: #ffffff; }

Toggle {
    width: 52px;
    height: 28px;
    background: #3a3a44;
    radius: 14px;
    transition: background 0.2s linear;
}
Toggle:checked { background: var(--primary); }

Toggle .toggle-knob {
    position: absolute;
    width: 24px;
    height: 24px;
    top: 2px;
    left: 2px;
    radius: 12px;
    background: #ffffff;
    transition: left 0.20s ease-out-cubic;
}
Toggle:checked .toggle-knob { left: 26px; }

.value-label {
    color: var(--primary-hi);
    font-size: 14px;
    min-width: 60px;
}