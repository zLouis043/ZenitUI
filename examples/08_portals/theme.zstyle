/* =========================================================================
   ZenitUI — Example 08: Portals
   Styling for Popup, Tooltip, ContextMenu and Modal.
   ========================================================================= */

:root {
    --bg:        #141418;
    --surface:   #1e1e24;
    --surface-hi:#26262e;
    --primary:   #4a9eff;
    --primary-hi:#7bc0ff;
    --text:      #e8e8ee;
    --text-dim:  #9090a0;
    --overlay:   #000000cc;
}

/* Root: a Stack that fills the viewport. Its two children — the page
   and the modal — overlap because Stack doesn't flow. */
Modal {
    background: var(--overlay);
    width: 100%;
    height: 100%;
    items-h: center;
    items-v: center;
}
/* Page: a Vertical column with the actual content. */
.page {
    background: var(--bg);
    color: var(--text);
    font-size: 14px;
    padding: 3vh 3vw;
    gap: 12px;
    width: 100%;
    height: 100%;
    items-h: stretch;
    items-v: start;
}

.panel {
    background: var(--surface);
    radius: 8px;
    padding: 14px;
    gap: 14px;
    width: 100%;
}

.title {
    color: var(--primary);
    font-size: 17px;
    letter-spacing: 1px;
}

.row {
    gap: 16px;
    items-v: center;
    width: 100%;
}

.row-label {
    color: var(--text-dim);
    font-size: 13px;
    min-width: 200px;
}

/* --- Buttons ----------------------------------------------------------- */
.btn {
    background: var(--primary);
    color: #ffffff;
    radius: 6px;
    padding: 8px 16px;
    transition: background 0.15s ease-out-quad;
}
.btn:hover   { background: var(--primary-hi); }

/* The box that receives right-click. */
.target-box {
    background: var(--surface-hi);
    color: var(--text-dim);
    radius: 6px;
    padding: 12px 20px;
    min-width: 220px;
    items-v: center;
}

/* --- Tooltip ----------------------------------------------------------- */
Tooltip {
    background: #101014ee;
    color: #ffffff;
    radius: 4px;
    padding: 6px 10px;
    border-width: 1px;
    border-color: #4a9eff;
    font-size: 12px;
}

/* --- Popup / ContextMenu ----------------------------------------------- */
Popup {
    background: #1a1a20f2;
    radius: 6px;
    padding: 6px;
    border-width: 1px;
    border-color: #4a4a55;
}

.popup-item {
    background: transparent;
    color: var(--text);
    radius: 4px;
    padding: 8px 14px;
    items-h: start;
    transition: background 0.10s linear;
}
.popup-item:hover   { background: #4a9eff66; }
.popup-item:pressed { background: #4a9effaa; }

/* --- Modal ------------------------------------------------------------- */
Modal {
    background: var(--overlay);
    items-h: center;
    items-v: center;
}

.modal-content {
    background: var(--surface);
    radius: 10px;
    padding: 24px;
    gap: 16px;
    min-width: 300px;
    border-width: 1px;
    border-color: #4a9eff;
}

.modal-title {
    color: var(--primary);
    font-size: 18px;
    letter-spacing: 1px;
}

.modal-actions {
    gap: 10px;
    justify: end;
    width: 100%;
}