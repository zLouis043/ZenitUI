/* =========================================================================
   ZenitUI — Example 10: Canvas
   Styling for the surrounding page and for the small scene inside each
   CanvasLayout.
   ========================================================================= */

:root {
    --bg:        #141418;
    --surface:   #1e1e24;
    --text:      #e8e8ee;
    --text-dim:  #9090a0;
    --primary:   #4a9eff;
}

Stack#root {
    width: 100%;
    height: 100%;
    items-h: stretch;
    items-v: stretch;
}

.page {
    background: var(--bg);
    color: var(--text);
    font-size: 14px;
    padding: 3vh 3vw;
    gap: 12px;
    width: 100%;
    height: 100%;
    items-h: stretch;
    items-v: start;
}

.panel {
    background: var(--surface);
    radius: 8px;
    padding: 14px;
    gap: 14px;
    width: 100%;
}

.title {
    color: var(--primary);
    font-size: 17px;
    letter-spacing: 1px;
}

.row {
    gap: 16px;
    items-v: center;
    width: 100%;
}

.row-label {
    color: var(--text-dim);
    font-size: 13px;
    min-width: 200px;
}

/* The CanvasLayout itself. We give it a background so the target area
   is visible even when its children are simple. */
Canvas {
    background: #0a0a0e;
    radius: 6px;
    border-width: 1px;
    border-color: #3a3a44;
    padding: 8px;
}

/* The scene inside each canvas. */
.scene {
    gap: 6px;
    items-h: center;
    items-v: center;
}

.scene-label {
    color: var(--text-dim);
    font-size: 12px;
}

.swatch {
    radius: 4px;
    min-width: 48px;
    min-height: 48px;
}