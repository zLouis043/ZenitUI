/* =========================================================================
   ZenitUI — Example 07: Effects
   Filters (filter:) and single-pass shaders (effect:).
   ========================================================================= */

:root {
    --bg:        #141418;
    --surface:   #1e1e24;
    --primary:   #4a9eff;
    --text:      #e8e8ee;
    --text-dim:  #9090a0;
}

Stack#page {
    background: var(--bg);
    color: var(--text);
    font-size: 14px;
    padding: 3vh 3vw;
    gap: 12px;
    width: 100%;
    height: 100%;
}

Panel {
    background: var(--surface);
    radius: 8px;
    padding: 14px;
    gap: 14px;
    width: 100%;
}

.title {
    color: var(--primary);
    font-size: 17px;
    letter-spacing: 1px;
}

.row {
    gap: 16px;
    items-v: center;
    width: 100%;
}

.row-label {
    color: var(--text-dim);
    font-size: 13px;
    min-width: 180px;
}

/* The box that each filter applies to. */
.card {
    background: #3a3a44;
    color: #ffffff;
    radius: 8px;
    padding: 14px 22px;
    min-width: 140px;
    items-h: center;
    items-v: center;
    font-size: 15px;
}

/* --- 1. blur ----------------------------------------------------------- */
.filter-blur {
    filter: blur(3px);
}

/* --- 2. drop-shadow ---------------------------------------------------- */
.filter-shadow {
    filter: drop-shadow(4px, 4px, #000000cc);
}

/* --- 3. sepia (custom filter, registered in main.cpp) ------------------ */
.filter-sepia {
    filter: sepia(0.9);
}

/* --- 4. effect: a single shader pass on the node's own draw calls ------ */
.effect-hue {
    effect: hueShift;
    background: #c8344a;
}

/* --- 5. two filters: each reads the original target. ---------------- */
.filter-both {
    filter: blur(2px), sepia(0.6);
}