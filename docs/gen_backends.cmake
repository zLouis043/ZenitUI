# Generates build/docs/generated_backends.dox from backends/*/*.hpp
# Run via: cmake -P docs/gen_backends.cmake

get_filename_component(ROOT_DIR "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(BACKENDS_DIR "${ROOT_DIR}/backends")
set(OUT_DIR "${ROOT_DIR}/build/docs")
set(OUT_FILE "${OUT_DIR}/generated_backends.dox")

file(MAKE_DIRECTORY "${OUT_DIR}")

function(_read_backend_tag text tag out_var)
    string(REGEX MATCH "(^|\n)[ \t]*//[ \t]*@${tag}[ \t]+([^\n]+)" _m "${text}")
    if(_m)
        string(STRIP "${CMAKE_MATCH_2}" _val)
        set(${out_var} "${_val}" PARENT_SCOPE)
    else()
        set(${out_var} "" PARENT_SCOPE)
    endif()
endfunction()

file(GLOB entries RELATIVE "${BACKENDS_DIR}" "${BACKENDS_DIR}/*")
list(SORT entries)

set(table_rows "")
set(detail_blocks "")

foreach(entry IN LISTS entries)
    set(dir "${BACKENDS_DIR}/${entry}")
    if(NOT IS_DIRECTORY "${dir}")
        continue()
    endif()

    file(GLOB headers RELATIVE "${dir}" "${dir}/*.hpp")
    list(SORT headers)

    foreach(hdr IN LISTS headers)
        file(READ "${dir}/${hdr}" head LIMIT 2048)
        string(REPLACE "\r\n" "\n" head "${head}")

        _read_backend_tag("${head}" "backend_name" b_name)
        if(b_name STREQUAL "")
            continue()
        endif()

        _read_backend_tag("${head}" "backend_target"   b_target)
        _read_backend_tag("${head}" "backend_role"     b_role)
        _read_backend_tag("${head}" "backend_features" b_features)
        _read_backend_tag("${head}" "backend_classes"  b_classes)

        if(b_target STREQUAL "")
            set(b_target "—")
        else()
            set(b_target "`${b_target}`")
        endif()
        if(b_role STREQUAL "")
            set(b_role "Backend implementation in `backends/${entry}/`.")
        endif()
        if(b_features STREQUAL "")
            set(b_features "Core 2D only")
        endif()

        set(class_refs "")
        set(class_bullets "")
        if(NOT b_classes STREQUAL "")
            string(REGEX REPLACE "[ ,]+" ";" cls_list "${b_classes}")
            foreach(cls IN LISTS cls_list)
                if(NOT class_refs STREQUAL "")
                    string(APPEND class_refs ", ")
                endif()
                string(APPEND class_refs "\\ref ${cls}")
                string(APPEND class_bullets " * - \\ref ${cls}\n")
            endforeach()
        endif()

        string(APPEND table_rows
            " * | **${b_name}** (`${entry}`) | ${b_target} | ${b_role} | ${b_features} | ${class_refs} |\n")

        string(APPEND detail_blocks
            " * \\section sec_backend_${entry} ${b_name} (`backends/${entry}/${hdr}`)\n"
            " * - **CMake target:** ${b_target}\n"
            " * - **Role:** ${b_role}\n"
            " * - **Supported optional features:** ${b_features}\n"
            " *\n"
            " * **Classes:**\n"
            "${class_bullets}"
            " *\n")
    endforeach()
endforeach()

set(out "/* Auto-generated by docs/gen_backends.cmake — do not edit manually. */\n\n")

if(NOT table_rows STREQUAL "")
    string(APPEND out
        "/**\n"
        " * \\page page_available_backends Available Backends\n"
        " *\n"
        " * This catalog is generated automatically from the backend headers under `backends/`.\n"
        " * Enable any combination via `-DZENITUI_BACKENDS=\"raylib;sdl3;mock\"`.\n"
        " *\n"
        " * | Backend | CMake Target | Role | Optional Features | Classes |\n"
        " * | :--- | :--- | :--- | :--- | :--- |\n"
        "${table_rows}"
        " *\n"
        "${detail_blocks}"
        " */\n\n"
        "/**\n"
        " * \\addtogroup grp_backends\n"
        " * \\par Available Backends\n"
        " * | Backend | CMake Target | Role | Optional Features | Classes |\n"
        " * | :--- | :--- | :--- | :--- | :--- |\n"
        "${table_rows}"
        " */\n")
endif()

file(WRITE "${OUT_FILE}" "${out}")