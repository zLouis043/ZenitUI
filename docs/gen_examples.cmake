# Generates build/docs/generated_examples.dox from examples/*/
# Run via: cmake -P docs/gen_examples.cmake

get_filename_component(ROOT_DIR "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(EXAMPLES_DIR "${ROOT_DIR}/examples")
set(OUT_DIR "${ROOT_DIR}/build/docs")
set(OUT_FILE "${OUT_DIR}/generated_examples.dox")

file(MAKE_DIRECTORY "${OUT_DIR}")

file(GLOB entries RELATIVE "${EXAMPLES_DIR}" "${EXAMPLES_DIR}/*")
list(SORT entries)

set(out "/* Auto-generated by docs/gen_examples.cmake — do not edit manually. */\n\n")
set(group_names "")

foreach(entry IN LISTS entries)
    set(dir "${EXAMPLES_DIR}/${entry}")

    if(NOT IS_DIRECTORY "${dir}" OR NOT EXISTS "${dir}/main.cpp")
        continue()
    endif()

    # Read optional metadata from the top of main.cpp:
    # // @doc   Short description of the example
    # // @group grp_widgets grp_core
    file(READ "${dir}/main.cpp" head LIMIT 1024)
    string(REPLACE "\r\n" "\n" head "${head}")

    set(desc "")
    string(REGEX MATCH "(^|\n)[ \t]*//[ \t]*@doc[ \t]+([^\n]+)" _m_desc "${head}")

    if(_m_desc)
        string(STRIP "${CMAKE_MATCH_2}" desc)
    endif()

    if(desc STREQUAL "")
        set(desc "Example from `examples/${entry}/`.")
    endif()

    string(REGEX MATCH "(^|\n)[ \t]*//[ \t]*@group[ \t]+([^\n]+)" _m_grp "${head}")

    if(_m_grp)
        string(STRIP "${CMAKE_MATCH_2}" grp_raw)
        string(REGEX REPLACE "[ ,]+" ";" grp_list "${grp_raw}")

        foreach(g IN LISTS grp_list)
            list(APPEND group_names "${g}")

            if(desc STREQUAL "")
                set(desc "Example from `examples/${entry}/`.")
            else()
                string(REPLACE "@" "&#64;" desc "${desc}")
                string(REPLACE "#" "\\#" desc "${desc}")
            endif()

            string(APPEND group_items_${g} " * - \\ref ${entry}/main.cpp \"${entry}\" — ${desc}\n")
        endforeach()
    endif()

    # Collect sibling source/style/markup/shader files in the same folder
    file(GLOB files RELATIVE "${dir}" "${dir}/*")
    list(SORT files)

    set(extra_blocks "")

    foreach(f IN LISTS files)
        if(IS_DIRECTORY "${dir}/${f}" OR f STREQUAL "main.cpp" OR f STREQUAL "CMakeLists.txt")
            continue()
        endif()

        get_filename_component(ext "${f}" LAST_EXT)
        string(TOLOWER "${ext}" ext)

        if(ext MATCHES "^\\.(hpp|h|cpp)$")
            string(APPEND extra_blocks " *\n * ### ${f}\n * \\include ${entry}/${f}\n")
        elseif(ext MATCHES "^\\.(zstyle|zm|fs|vs|glsl)$")
            string(APPEND extra_blocks " *\n * ### ${f}\n * \\verbinclude ${entry}/${f}\n")
        endif()
    endforeach()

    string(APPEND out "/** \\example ${entry}/main.cpp\n")
    string(APPEND out " * ${desc}\n")

    if(NOT extra_blocks STREQUAL "")
        string(APPEND out "${extra_blocks}")
        string(APPEND out " *\n * ### main.cpp\n")
    endif()

    string(APPEND out " */\n\n")
endforeach()

if(group_names)
    list(REMOVE_DUPLICATES group_names)

    foreach(g IN LISTS group_names)
        string(APPEND out "/**\n * \\addtogroup ${g}\n * \\par Live examples\n${group_items_${g}} */\n\n")
    endforeach()
endif()

file(WRITE "${OUT_FILE}" "${out}")